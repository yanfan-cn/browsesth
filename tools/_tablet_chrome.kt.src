enum class TabletSidePanel { None, Bookmarks, History, Toolbox, Tabs }

@Composable
fun TabletBrowserShell(
    address: String,
    onAddressChange: (String) -> Unit,
    onSubmitAddress: () -> Unit,
    onBack: () -> Unit,
    onForward: () -> Unit,
    onRefresh: () -> Unit,
    onReader: () -> Unit,
    chromeVisible: Boolean,
    sidePanel: TabletSidePanel,
    onSidePanelChange: (TabletSidePanel) -> Unit,
    onOpenUrl: (String) -> Unit,
    content: @Composable () -> Unit,
) {
    val scheme = LegadoTheme.colorScheme
    val context = LocalContext.current
    val chromePrefs = remember { BrowserChromePrefs(context) }
    var uaMode by remember { mutableStateOf(chromePrefs.uaModeOrDefault(true)) }

    Column(modifier = ComposeModifier.fillMaxSize().background(scheme.surface)) {
        if (chromeVisible) {
            TabletTabStrip(
                onNewTab = { BrowserTabManager.openNewTab(url = null, select = true) },
                onSelectTab = { id ->
                    BrowserTabManager.switchTo(id)
                    onSidePanelChange(TabletSidePanel.None)
                },
                onCloseTab = { BrowserTabManager.close(it) },
            )
            TabletFunctionBar(
                address = address,
                onAddressChange = onAddressChange,
                onSubmitAddress = onSubmitAddress,
                onBack = onBack,
                onForward = onForward,
                onRefresh = onRefresh,
                onOpenTabs = {
                    onSidePanelChange(
                        if (sidePanel == TabletSidePanel.Tabs) TabletSidePanel.None else TabletSidePanel.Tabs,
                    )
                },
                onOpenBookmarks = {
                    onSidePanelChange(
                        if (sidePanel == TabletSidePanel.Bookmarks) TabletSidePanel.None else TabletSidePanel.Bookmarks,
                    )
                },
                onOpenHistory = {
                    onSidePanelChange(
                        if (sidePanel == TabletSidePanel.History) TabletSidePanel.None else TabletSidePanel.History,
                    )
                },
                onReader = onReader,
                onOpenToolbox = {
                    onSidePanelChange(
                        if (sidePanel == TabletSidePanel.Toolbox) TabletSidePanel.None else TabletSidePanel.Toolbox,
                    )
                },
            )
        }
        Box(modifier = ComposeModifier.weight(1f).fillMaxWidth()) {
            content()
            if (sidePanel != TabletSidePanel.None) {
                Box(
                    modifier = ComposeModifier
                        .fillMaxSize()
                        .background(scheme.scrim.copy(alpha = 0.32f))
                        .clickable { onSidePanelChange(TabletSidePanel.None) },
                )
                Box(
                    modifier = ComposeModifier
                        .align(Alignment.CenterEnd)
                        .fillMaxHeight()
                        .fillMaxWidth(1f / 3f)
                        .background(scheme.surfaceContainerHigh)
                        .clickable(enabled = false) {},
                ) {
                    when (sidePanel) {
                        TabletSidePanel.Bookmarks -> TabletEntryPanel(
                            title = "\u6536\u85cf",
                            entries = BrowseStore(context).bookmarks(),
                            onOpen = {
                                onOpenUrl(it)
                                onSidePanelChange(TabletSidePanel.None)
                            },
                            onClose = { onSidePanelChange(TabletSidePanel.None) },
                        )
                        TabletSidePanel.History -> TabletEntryPanel(
                            title = "\u5386\u53f2",
                            entries = BrowseStore(context).history(),
                            onOpen = {
                                onOpenUrl(it)
                                onSidePanelChange(TabletSidePanel.None)
                            },
                            onClose = { onSidePanelChange(TabletSidePanel.None) },
                        )
                        TabletSidePanel.Tabs -> TabletTabsPanel(
                            onClose = { onSidePanelChange(TabletSidePanel.None) },
                        )
                        TabletSidePanel.Toolbox -> TabletToolboxPanel(
                            uaMode = uaMode,
                            onUaChange = {
                                uaMode = it
                                chromePrefs.uaMode = it
                            },
                            onClose = { onSidePanelChange(TabletSidePanel.None) },
                        )
                        TabletSidePanel.None -> Unit
                    }
                }
            }
        }
    }
}

@Composable
private fun TabletTabStrip(
    onNewTab: () -> Unit,
    onSelectTab: (String) -> Unit,
    onCloseTab: (String) -> Unit,
) {
    val scheme = LegadoTheme.colorScheme
    val tabs by BrowserTabManager.tabs.collectAsStateWithLifecycle()
    val activeId by BrowserTabManager.activeTabId.collectAsStateWithLifecycle()
    Row(
        modifier = ComposeModifier
            .fillMaxWidth()
            .statusBarsPadding()
            .height(40.dp)
            .background(scheme.surfaceContainer)
            .horizontalScroll(rememberScrollState())
            .padding(horizontal = 8.dp),
        verticalAlignment = Alignment.CenterVertically,
    ) {
        tabs.forEach { tab ->
            val selected = tab.id == activeId
            Row(
                modifier = ComposeModifier
                    .padding(end = 6.dp)
                    .clip(RoundedCornerShape(topStart = 10.dp, topEnd = 10.dp))
                    .background(if (selected) scheme.surface else scheme.surfaceContainerHighest)
                    .clickable { onSelectTab(tab.id) }
                    .padding(horizontal = 10.dp, vertical = 6.dp)
                    .width(140.dp),
                verticalAlignment = Alignment.CenterVertically,
            ) {
                Text(
                    text = tab.title?.takeIf { it.isNotBlank() } ?: tab.url?.take(28) ?: "\u65b0\u6807\u7b7e\u9875",
                    modifier = ComposeModifier.weight(1f),
                    maxLines = 1,
                    overflow = TextOverflow.Ellipsis,
                    fontSize = 12.sp,
                    color = scheme.onSurface,
                )
                Icon(
                    imageVector = Icons.Default.Close,
                    contentDescription = "close",
                    modifier = ComposeModifier.size(16.dp).clickable { onCloseTab(tab.id) },
                    tint = scheme.onSurfaceVariant,
                )
            }
        }
        IconButton(onClick = onNewTab, modifier = ComposeModifier.size(36.dp)) {
            Icon(Icons.Default.Add, contentDescription = "new tab")
        }
    }
}

@Composable
private fun TabletFunctionBar(
    address: String,
    onAddressChange: (String) -> Unit,
    onSubmitAddress: () -> Unit,
    onBack: () -> Unit,
    onForward: () -> Unit,
    onRefresh: () -> Unit,
    onOpenTabs: () -> Unit,
    onOpenBookmarks: () -> Unit,
    onOpenHistory: () -> Unit,
    onReader: () -> Unit,
    onOpenToolbox: () -> Unit,
) {
    val scheme = LegadoTheme.colorScheme
    val context = LocalContext.current
    val ntpPrefs = remember { BrowserNtpPrefs(context) }
    var engine by remember { mutableStateOf(ntpPrefs.searchEngine()) }
    var engineMenu by remember { mutableStateOf(false) }

    Row(
        modifier = ComposeModifier
            .fillMaxWidth()
            .height(52.dp)
            .background(scheme.surface)
            .padding(horizontal = 8.dp),
        verticalAlignment = Alignment.CenterVertically,
    ) {
        ChromeIcon(Icons.AutoMirrored.Filled.ArrowBack, "back", onBack)
        ChromeIcon(Icons.AutoMirrored.Filled.ArrowForward, "forward", onForward)
        ChromeIcon(Icons.Default.Refresh, "reload", onRefresh)
        Spacer(modifier = ComposeModifier.width(8.dp))
        Row(
            modifier = ComposeModifier
                .weight(1f)
                .height(40.dp)
                .clip(RoundedCornerShape(20.dp))
                .background(scheme.surfaceContainerHighest)
                .padding(horizontal = 10.dp),
            verticalAlignment = Alignment.CenterVertically,
        ) {
            Box {
                Box(
                    modifier = ComposeModifier
                        .size(26.dp)
                        .clip(RoundedCornerShape(13.dp))
                        .background(scheme.surface)
                        .clickable { engineMenu = true },
                    contentAlignment = Alignment.Center,
                ) {
                    Image(
                        painter = painterResource(engine.logoRes),
                        contentDescription = engine.displayName,
                        modifier = ComposeModifier.size(20.dp),
                        contentScale = ContentScale.Fit,
                    )
                }
                DropdownMenu(expanded = engineMenu, onDismissRequest = { engineMenu = false }) {
                    BrowserSearchEngine.entries.forEach { item ->
                        DropdownMenuItem(
                            text = { Text(item.displayName) },
                            onClick = {
                                engine = item
                                ntpPrefs.searchEngineId = item.id
                                engineMenu = false
                            },
                        )
                    }
                }
            }
            Spacer(modifier = ComposeModifier.width(8.dp))
            BasicTextField(
                value = address,
                onValueChange = onAddressChange,
                modifier = ComposeModifier.weight(1f),
                singleLine = true,
                textStyle = TextStyle(color = scheme.onSurface, fontSize = 14.sp),
                cursorBrush = SolidColor(scheme.primary),
                keyboardOptions = KeyboardOptions(imeAction = ImeAction.Go),
                keyboardActions = KeyboardActions(onGo = {
                    val url = resolveBrowserNavigationInput(address, engine)
                    if (url.isNotEmpty()) {
                        onAddressChange(url)
                        onSubmitAddress()
                    }
                }),
            )
        }
        ChromeIcon(Icons.Default.FilterNone, "tabs", onOpenTabs)
        ChromeIcon(Icons.Default.Bookmark, "bookmarks", onOpenBookmarks)
        ChromeIcon(Icons.Default.History, "history", onOpenHistory)
        ChromeIcon(Icons.Default.AutoStories, "reader", onReader)
        ChromeIcon(Icons.Default.Menu, "toolbox", onOpenToolbox)
    }
}

@Composable
private fun ChromeIcon(icon: ImageVector, desc: String, onClick: () -> Unit) {
    IconButton(onClick = onClick, modifier = ComposeModifier.size(40.dp)) {
        Icon(imageVector = icon, contentDescription = desc, modifier = ComposeModifier.size(22.dp))
    }
}

@Composable
private fun TabletEntryPanel(
    title: String,
    entries: List<BrowseStore.Entry>,
    onOpen: (String) -> Unit,
    onClose: () -> Unit,
) {
    val scheme = LegadoTheme.colorScheme
    Column(modifier = ComposeModifier.fillMaxSize()) {
        Row(
            modifier = ComposeModifier.fillMaxWidth().padding(12.dp),
            verticalAlignment = Alignment.CenterVertically,
        ) {
            Text(text = title, modifier = ComposeModifier.weight(1f), fontSize = 18.sp, color = scheme.onSurface)
            IconButton(onClick = onClose) {
                Icon(Icons.Default.Close, contentDescription = "close")
            }
        }
        HorizontalDivider()
        LazyColumn(modifier = ComposeModifier.fillMaxSize()) {
            items(entries, key = { it.url + it.title }) { item ->
                Column(
                    modifier = ComposeModifier
                        .fillMaxWidth()
                        .clickable { onOpen(item.url) }
                        .padding(horizontal = 14.dp, vertical = 12.dp),
                ) {
                    Text(
                        text = item.title.ifBlank { item.url },
                        maxLines = 1,
                        overflow = TextOverflow.Ellipsis,
                        color = scheme.onSurface,
                    )
                    Text(
                        text = item.url,
                        maxLines = 1,
                        overflow = TextOverflow.Ellipsis,
                        fontSize = 12.sp,
                        color = scheme.onSurfaceVariant,
                    )
                }
            }
        }
    }
}

@Composable
private fun TabletTabsPanel(onClose: () -> Unit) {
    val tabs by BrowserTabManager.tabs.collectAsStateWithLifecycle()
    Column(modifier = ComposeModifier.fillMaxSize()) {
        Row(
            modifier = ComposeModifier.fillMaxWidth().padding(12.dp),
            verticalAlignment = Alignment.CenterVertically,
        ) {
            Text(text = "\u6807\u7b7e\u9875", modifier = ComposeModifier.weight(1f), fontSize = 18.sp)
            TextButton(onClick = {
                BrowserTabManager.openNewTab(url = null, select = true)
                onClose()
            }) { Text("\u65b0\u5efa") }
            IconButton(onClick = onClose) {
                Icon(Icons.Default.Close, contentDescription = "close")
            }
        }
        HorizontalDivider()
        LazyColumn {
            items(tabs, key = { it.id }) { tab ->
                Row(
                    modifier = ComposeModifier
                        .fillMaxWidth()
                        .clickable {
                            BrowserTabManager.switchTo(tab.id)
                            onClose()
                        }
                        .padding(14.dp),
                    verticalAlignment = Alignment.CenterVertically,
                ) {
                    Text(
                        text = tab.title ?: tab.url ?: "\u65b0\u6807\u7b7e\u9875",
                        modifier = ComposeModifier.weight(1f),
                        maxLines = 1,
                        overflow = TextOverflow.Ellipsis,
                    )
                    IconButton(onClick = { BrowserTabManager.close(tab.id) }) {
                        Icon(Icons.Default.Close, contentDescription = "close tab")
                    }
                }
            }
        }
    }
}

@Composable
private fun TabletToolboxPanel(
    uaMode: BrowserUa.Mode,
    onUaChange: (BrowserUa.Mode) -> Unit,
    onClose: () -> Unit,
) {
    val scheme = LegadoTheme.colorScheme
    val context = LocalContext.current
    val chromePrefs = remember { BrowserChromePrefs(context) }
    var autoHide by remember { mutableStateOf(chromePrefs.autoHideTopBar) }
    Column(modifier = ComposeModifier.fillMaxSize().padding(16.dp)) {
        Row(verticalAlignment = Alignment.CenterVertically) {
            Text(text = "\u5de5\u5177\u7bb1", modifier = ComposeModifier.weight(1f), fontSize = 18.sp)
            IconButton(onClick = onClose) {
                Icon(Icons.Default.Close, contentDescription = "close")
            }
        }
        HorizontalDivider(modifier = ComposeModifier.padding(vertical = 8.dp))
        Text(text = "UA", color = scheme.onSurface, fontSize = 15.sp)
        Spacer(modifier = ComposeModifier.height(8.dp))
        Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
            TextButton(onClick = { onUaChange(BrowserUa.Mode.Mobile) }) {
                Icon(
                    imageVector = Icons.Default.PhoneAndroid,
                    contentDescription = null,
                    modifier = ComposeModifier.size(18.dp),
                )
                Spacer(modifier = ComposeModifier.width(4.dp))
                Text(if (uaMode == BrowserUa.Mode.Mobile) "Mobile *" else "Mobile")
            }
            TextButton(onClick = { onUaChange(BrowserUa.Mode.Desktop) }) {
                Icon(
                    imageVector = Icons.Default.Computer,
                    contentDescription = null,
                    modifier = ComposeModifier.size(18.dp),
                )
                Spacer(modifier = ComposeModifier.width(4.dp))
                Text(if (uaMode == BrowserUa.Mode.Desktop) "Desktop *" else "Desktop")
            }
        }
        Text(
            text = "Reload page after switching UA",
            modifier = ComposeModifier.padding(top = 4.dp, bottom = 16.dp),
            fontSize = 12.sp,
            color = scheme.onSurfaceVariant,
        )
        Row(verticalAlignment = Alignment.CenterVertically) {
            Text(text = "Auto-hide top bar on scroll", modifier = ComposeModifier.weight(1f))
            Switch(
                checked = autoHide,
                onCheckedChange = {
                    autoHide = it
                    chromePrefs.autoHideTopBar = it
                },
            )
        }
    }
}
